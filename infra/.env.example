# ThinkBuild Accounts - Environment Configuration Template
# Duplicate this file to .env before starting the services:
# cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=thinkbuild_accounts
POSTGRES_USER=thinkbuild
POSTGRES_PASSWORD=ThinkBuild@2024
DB_URL=jdbc:postgresql://db:5432/thinkbuild_accounts
DB_USERNAME=thinkbuild
DB_PASSWORD=ThinkBuild@2024

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT Authentication Secrets (256-bit Base64 Encoded)
# Generate new random 256-bit keys for production using: openssl rand -base64 32
JWT_SECRET=c21NdmhkK3k2QkxvSEJCVUZSZDRhT0Jrc21yU09iQ3JBNTN0N0hscXNuaz0=
JWT_REFRESH_SECRET=djl5WGpndzBNY3lEaXkrcVJVRzM5N211Y1N5dmtxNjhIeXh6clNZcW1MQT0=

# JWT Token Expiration (in milliseconds)
# Access Token: 15 minutes (900,000 ms)
JWT_ACCESS_EXPIRY_MS=900000
# Refresh Token: 7 days (604,800,000 ms)
JWT_REFRESH_EXPIRY_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost
